# Másold .env néven (cp .env.example .env). A .env nem kerül gitbe.
# Helyi fejlesztéshez ez így jó:
DEBUG=1
SECRET_KEY=csak-fejlesztesi-kulcs

# Alapértelmezett adatbázis: SQLite. PostgreSQL (docker compose up -d db):
# DATABASE_URL=postgres://fixmyhome:fixmyhome@localhost:5432/fixmyhome

# ---------------------------------------------------------------------------
# ÉLES vagy ALAGUTAS futtatás (ha más is eléri az oldalt):
#   * DEBUG=0 KÖTELEZŐ. DEBUG=1 mellett a hibaoldalak kiadják a beállításokat.
#   * Új, véletlen SECRET_KEY KÖTELEZŐ (legalább 50 karakter). A fenti kulccsal
#     DEBUG=0 mellett az oldal el sem indul. Generálás:
#       python -c "import secrets; print(secrets.token_urlsafe(50))"
#   * PONTOS címet adj meg, ne *.trycloudflare.com-ot (az bárki alagútját elfogadná).
#
# DEBUG=0
# SECRET_KEY=<ide-a-generalt-veletlen-kulcs>
# ALLOWED_HOSTS=<a-te-alagutad>.trycloudflare.com
# CSRF_TRUSTED_ORIGINS=https://<a-te-alagutad>.trycloudflare.com
#
# !!! PROXY / ALAGÚT MÖGÖTT: TRUST_PROXY_SSL_HEADER=1 NÉLKÜL VÉGTELEN ÁTIRÁNYÍTÁS LESZ !!!
# (A Django a proxytól sima HTTP-t lát, ezért újra és újra HTTPS-re irányít.)
# Proxy NÉLKÜL ne kapcsold be: akkor a kliens hamisíthatja az X-Forwarded-Proto fejlécet.
# TRUST_PROXY_SSL_HEADER=1
#
# Csak DEBUG=0 mellett számítanak (alapértékek zárójelben):
# SECURE_SSL_REDIRECT=1        (1) HTTP -> HTTPS átirányítás; értéke 1 vagy 0
# SECURE_HSTS_SECONDS=3600     (3600) HSTS másodpercben; 0 = kikapcsolva

# Jelszótippelés elleni védelem (django-axes), fejlesztésben és élesben is (alapértékek zárójelben):
# AXES_FAILURE_LIMIT=5         (5) ennyi hibás próba után tilt; egész szám, legalább 1
# AXES_COOLOFF_MINUTES=15      (15) tiltás hossza percben; egész szám, legalább 1

# Levélküldés (e-mail-megerősítés). Alapból "console": a levél a terminálban jelenik meg, nem megy ki.
# FIGYELEM: a console backend élesben a szerver naplójába írná a megerősítő linkeket. Élesben smtp kell.
# EMAIL_BACKEND=console        (console) console vagy smtp
# EMAIL_HOST=smtp.example.com  smtp mellett kötelező
# EMAIL_PORT=587               (587) egész szám, 1–65535
# EMAIL_USE_TLS=1              (1) STARTTLS; értéke 1 vagy 0
# EMAIL_HOST_USER=<smtp-felhasznalonev>
# EMAIL_HOST_PASSWORD=<smtp-jelszo>   csak a .env-be írd, a repóba soha
# EMAIL_TIMEOUT=10             (10) másodperc, ennyit vár az SMTP-szerverre
# DEFAULT_FROM_EMAIL=MesterKereső <noreply@example.com>
# SITE_NAME=FixMyHome          (FixMyHome) az oldal neve az elfelejtett jelszó levélben

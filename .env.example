# Másold .env néven (cp .env.example .env). A .env nem kerül gitbe.
# Helyi fejlesztéshez ez így jó:
DEBUG=1
SECRET_KEY=csak-fejlesztesi-kulcs

# Élesben: DEBUG=0 (vagy hiányzik), egyedi, hosszú, titkos SECRET_KEY és ALLOWED_HOSTS.
# Alapértelmezett adatbázis: SQLite. Élesben PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/mesterkereso
